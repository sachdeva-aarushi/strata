# ==============================================================================
# STRATA Environment Configuration Template
# Copy this file to .env in your root directory or apps/api/ before starting services.
# NEVER commit .env with real production secrets to version control.
# ==============================================================================
# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Retrieve from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Public / Anon key for client access (if needed for future frontend slices)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Service role key (BACKEND ONLY — privileged access, never expose to frontend or git)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase database user password
SUPABASE_DB_PASSWORD=

# Application General
APP_NAME=STRATA
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# Database Persistence
# ==============================================================================
# The primary durable database URL. Supabase provides this in Dashboard -> 
# Project Settings -> Database -> Connection String -> URI.
#
# Option A: Supabase PostgreSQL (Direct connection, port 5432)
# DATABASE_URL=postgresql://postgres:<YOUR-PASSWORD>@db.<YOUR-PROJECT-REF>.supabase.co:5432/postgres?sslmode=require
#
# Option B: Supabase Connection Pooler (Transaction mode, port 6543)
# DATABASE_URL=postgresql://postgres.<YOUR-PROJECT-REF>:<YOUR-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
#
# Option C: Local Docker PostgreSQL (see infra/docker-compose.yml)
# DATABASE_URL=postgresql://strata_user:strata_password@localhost:5432/strata
#
# Option D: Zero-setup local SQLite (default for development/tests)
DATABASE_URL=sqlite:///./strata.db
DATABASE_CONNECT_TIMEOUT=10

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
# Replace with a strong random secret key in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-this-in-production-to-a-secure-random-secret-key-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Testing / Mock Settings
MOCK_AUTH_ENABLED=true

# LLM 
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# TinyFish 
TINYFISH_API_KEY=
